---
import { ArrowRight, Check, CircleAlert } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/sections/CTASection.astro';
import Button from '../../components/ui/Button.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import IconBadge from '../../components/ui/IconBadge.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import { solutions, type Solution } from '../../data/solutions';
import { features, product } from '../../config/site';

export function getStaticPaths() {
  return solutions.map((solution) => ({ params: { slug: solution.slug }, props: { solution } }));
}

interface Props {
  solution: Solution;
}

const { solution } = Astro.props;
const others = solutions.filter((s) => s.slug !== solution.slug).slice(0, 3);
const Icon = solution.icon;
---

<BaseLayout title={solution.name} description={solution.hero.description}>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden border-b border-border">
    <div class="absolute inset-0 -z-10 bg-grid mask-fade-top" aria-hidden="true"></div>
    <div class="absolute -top-40 left-1/2 -z-10 h-80 w-[48rem] -translate-x-1/2 glow" aria-hidden="true"></div>
    <div class="container-page py-16 sm:py-20 lg:py-24">
      <nav aria-label="Breadcrumb" class="mb-8 text-sm text-muted-foreground">
        <a href="/solutions" class="hover:text-foreground">Solutions</a>
        <span class="mx-2">/</span>
        <span class="text-foreground">{solution.name}</span>
      </nav>
      <div class="grid items-end gap-12 lg:grid-cols-[1.4fr_1fr]">
        <div>
          <div class="mb-5 flex items-center gap-3">
            <IconBadge><Icon /></IconBadge>
            <Eyebrow>{solution.name}</Eyebrow>
          </div>
          <h1 class="text-4xl leading-[1.08] font-semibold text-foreground sm:text-5xl lg:text-[3.5rem]">{solution.hero.title}</h1>
          <p class="mt-6 max-w-2xl text-lg text-muted-foreground sm:text-xl">{solution.hero.description}</p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <Button href={`/demo?industry=${solution.slug}`} size="lg">Book a demo <ArrowRight class="size-4" /></Button>
            <Button href="/product" size="lg" variant="outline">How {product.shortName} works</Button>
          </div>
        </div>
        <dl class="grid gap-4 sm:grid-cols-3 lg:grid-cols-1">
          {
            solution.metrics.map((m) => (
              <div class="rounded-2xl border border-border bg-card/80 p-5 shadow-soft backdrop-blur">
                <dt class="sr-only">{m.label}</dt>
                <dd>
                  <span class="block text-3xl font-semibold tracking-tight text-foreground">{m.value}</span>
                  <span class="mt-1 block text-sm text-muted-foreground">{m.label}</span>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- Challenges -->
  <section class="py-20 sm:py-28">
    <div class="container-page">
      <SectionHeader
        eyebrow="The challenge"
        title="Why the old way doesn’t scale"
        description="Teams are asked to make faster, higher-stakes decisions about places they can’t see often enough."
      />
      <ul class="mt-14 grid gap-6 md:grid-cols-3">
        {
          solution.challenges.map((c) => (
            <li class="rounded-2xl border border-border bg-card p-7 shadow-soft">
              <CircleAlert class="size-6 text-rose-500" />
              <h3 class="mt-5 text-lg font-semibold text-foreground">{c.title}</h3>
              <p class="mt-2 leading-relaxed text-muted-foreground">{c.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Use cases -->
  <section class="border-y border-border bg-muted/40 py-20 sm:py-28">
    <div class="container-page grid gap-12 lg:grid-cols-[1fr_1.5fr] lg:gap-16">
      <div>
        <SectionHeader
          align="left"
          eyebrow="Use cases"
          title={`What teams do with ${product.shortName}`}
          description="Start with a proven workflow, then adapt models, cadences and alerts to your operations."
        />
        <div class="mt-8 rounded-2xl border border-border bg-card p-6 shadow-soft">
          <p class="text-sm font-medium text-foreground">Models used</p>
          <ul class="mt-3 flex flex-wrap gap-2">
            {
              solution.models.map((m) => (
                <li class="rounded-md border border-border bg-background px-2 py-1 font-mono text-xs text-muted-foreground">{m}</li>
              ))
            }
          </ul>
        </div>
      </div>
      <ul class="grid gap-5 sm:grid-cols-2">
        {
          solution.useCases.map((u, i) => (
            <li class="rounded-2xl border border-border bg-card p-6 shadow-soft">
              <span class="font-mono text-xs text-primary">0{i + 1}</span>
              <h3 class="mt-3 font-semibold text-foreground">{u.title}</h3>
              <p class="mt-2 text-[0.95rem] leading-relaxed text-muted-foreground">{u.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Quote -->
  <section class="py-20 sm:py-28">
    <div class="container-page">
      <figure class="mx-auto max-w-3xl text-center">
        <svg viewBox="0 0 24 24" class="mx-auto size-9 text-primary/50" fill="currentColor" aria-hidden="true">
          <path d="M9.6 5C6 6.6 4 9.5 4 13.4V19h6v-6H7.3c.2-2.4 1.5-4.1 3.7-5.2L9.6 5Zm10 0C16 6.6 14 9.5 14 13.4V19h6v-6h-2.7c.2-2.4 1.5-4.1 3.7-5.2L19.6 5Z" />
        </svg>
        <blockquote class="mt-6 text-2xl leading-snug font-medium text-foreground sm:text-3xl">“{solution.quote.text}”</blockquote>
        <figcaption class="mt-8 text-sm">
          <span class="block font-semibold text-foreground">{solution.quote.name}</span>
          <span class="text-muted-foreground">{solution.quote.role}, {solution.quote.company}</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Why us -->
  <section class="border-t border-border py-20 sm:py-24">
    <div class="container-page">
      <div class="grid gap-10 rounded-3xl border border-border bg-card p-8 shadow-soft sm:p-12 lg:grid-cols-2">
        <div>
          <h2 class="text-2xl font-semibold text-foreground sm:text-3xl">Live in weeks, not quarters</h2>
          <p class="mt-3 text-muted-foreground">
            A dedicated solutions engineer sets up your areas, models and alerts during a 14-day pilot on your own data.
          </p>
        </div>
        <ul class="grid gap-3 sm:grid-cols-2">
          {
            ['Pilot on your own AOIs', 'Pre-configured workflows', 'Accuracy report on your data', 'Integrates with your tools', 'Enterprise security', features.pricing ? 'Transparent, area-based pricing' : 'Dedicated solutions engineer'].map((t) => (
              <li class="flex items-center gap-2.5 text-foreground">
                <Check class="size-4.5 shrink-0 text-primary" />
                {t}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Other solutions -->
  <section class="pb-4">
    <div class="container-page">
      <h2 class="text-lg font-semibold text-foreground">Explore other solutions</h2>
      <ul class="mt-6 grid gap-4 md:grid-cols-3">
        {
          others.map((s) => (
            <li>
              <a
                href={`/solutions/${s.slug}`}
                class="group flex items-center gap-4 rounded-2xl border border-border bg-card p-5 shadow-soft transition hover:border-primary/40"
              >
                <IconBadge>
                  <s.icon />
                </IconBadge>
                <span class="font-medium text-foreground">{s.name}</span>
                <ArrowRight class="ml-auto size-4 text-muted-foreground transition group-hover:translate-x-0.5 group-hover:text-primary" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CTASection />
</BaseLayout>
