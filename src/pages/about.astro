---
import { MapPin } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import CTASection from '../components/sections/CTASection.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import { site } from '../config/site';

const values = [
  { title: 'Say what we find', description: 'If your data needs more work than you hoped, or the other platform fits better, you hear it in the assessment.' },
  { title: 'Fixed prices', description: 'Each stage has an agreed price and scope, so neither side is guessing about the bill.' },
  { title: 'Leave you independent', description: 'Scripts, mappings and code are handed over, so you are never locked in to us.' },
  { title: 'Treat data as critical', description: 'Utility networks are critical infrastructure. Access is minimal, logged where you allow it, and removed at the end.' },
];
---

<BaseLayout title="About" description={`${site.name} is a GIS services team in Delhi that helps utilities and GIS firms modernise their network data and web maps.`}>
  <PageHero
    eyebrow="About us"
    title="A small GIS team that does the work itself"
    description={`${site.name} helps utilities and GIS firms move their network data onto modern platforms and build the web apps on top.`}
  />

  <section class="py-20 sm:py-28">
    <div class="container-page grid gap-12 lg:grid-cols-2 lg:gap-20">
      <SectionHeader align="left" eyebrow="Who we are" title="GIS people, not a sales team" />
      <div class="space-y-5 text-lg leading-relaxed text-muted-foreground">
        <p>
          {site.name} is founded and run by GIS practitioners. Our background is in ArcGIS: editing and maintaining utility data, building
          web GIS apps with the ArcGIS Maps SDK for JavaScript, and supporting the people who use them. We also build on GeoServer,
          PostGIS, OpenLayers and Leaflet.
        </p>
        <p>
          We started {site.name} because a lot of utility GIS work is stuck: ArcMap is retired, geometric networks can’t be edited in
          ArcGIS Pro, and the teams who know the data are too busy keeping it running to migrate it.
        </p>
        <p>We are small on purpose. The people who scope your project are the people who do the work.</p>
      </div>
    </div>
  </section>

  <section class="border-y border-border bg-muted/40 py-20 sm:py-28">
    <div class="container-page">
      <SectionHeader eyebrow="Principles" title="How we work with you" />
      <ul class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          values.map((v, i) => (
            <li class="rounded-2xl border border-border bg-card p-7 shadow-soft">
              <span class="font-mono text-sm text-primary">0{i + 1}</span>
              <h3 class="mt-4 font-semibold text-foreground">{v.title}</h3>
              <p class="mt-2 leading-relaxed text-muted-foreground">{v.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="py-20 sm:py-24">
    <div class="container-page max-w-3xl">
      <div class="flex items-start gap-4 rounded-2xl border border-border bg-card p-6 shadow-soft">
        <MapPin class="mt-0.5 size-5 shrink-0 text-primary" />
        <div>
          <h2 class="font-semibold text-foreground">Delhi, India</h2>
          <p class="mt-1 text-muted-foreground">
            We work remotely with clients in North America, the UK and Australia, with calls scheduled in your working hours.
          </p>
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
