---
import { Check, Minus } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import FAQ from '../components/sections/FAQ.astro';
import CTASection from '../components/sections/CTASection.astro';
import Button from '../components/ui/Button.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import { comparison, plans, pricingFaq } from '../data/pricing';
import { product } from '../config/site';

const fmt = (n: number) => `$${n.toLocaleString('en-US')}`;

const addons = [
  { title: 'Very-high-res tasking', price: 'From $18 / km²', description: 'Task 30–50 cm satellites over your sites on demand, with priority collection windows.' },
  { title: 'Custom model training', price: 'From $6,000', description: 'Our ML team builds and validates a model for your objects, with an accuracy report.' },
  { title: 'Historical backfill', price: 'From $2 / km²', description: 'Run any model across up to ten years of archive imagery to build a baseline.' },
];
---

<BaseLayout title="Pricing" description={`Simple, area-based pricing for ${product.name}. Start with a 14-day pilot on your own data.`}>
  <PageHero
    eyebrow="Pricing"
    title="Simple pricing that scales with your footprint"
    description="Pay for the area you monitor, not for pixels or seats you don’t use. Every plan starts with a 14-day pilot on your own data."
  />

  <section class="py-16 sm:py-20" id="plans">
    <div class="container-page group/pricing" data-billing="annual" data-pricing>
      <!-- Billing toggle -->
      <div class="flex justify-center">
        <div role="radiogroup" aria-label="Billing period" class="inline-flex items-center rounded-full border border-border bg-muted p-1">
          <button
            type="button"
            role="radio"
            aria-checked="false"
            data-billing-option="monthly"
            class="rounded-full px-4 py-1.5 text-sm font-medium text-muted-foreground transition-colors aria-checked:bg-background aria-checked:text-foreground aria-checked:shadow-sm"
          >
            Monthly
          </button>
          <button
            type="button"
            role="radio"
            aria-checked="true"
            data-billing-option="annual"
            class="flex items-center gap-2 rounded-full px-4 py-1.5 text-sm font-medium text-muted-foreground transition-colors aria-checked:bg-background aria-checked:text-foreground aria-checked:shadow-sm"
          >
            Annual
            <span class="rounded-full bg-primary-soft px-1.5 py-0.5 text-[10px] font-semibold text-primary-soft-foreground">−20%</span>
          </button>
        </div>
      </div>

      <!-- Plans -->
      <ul class="mt-12 grid gap-6 lg:grid-cols-3">
        {
          plans.map((plan) => (
            <li
              class:list={[
                'relative flex flex-col rounded-3xl border bg-card p-8 shadow-soft',
                plan.highlighted ? 'border-primary/50 shadow-elevated ring-4 ring-primary/10' : 'border-border',
              ]}
            >
              {plan.highlighted && (
                <span class="absolute -top-3 left-8 rounded-full bg-primary px-3 py-1 text-xs font-semibold text-primary-foreground">
                  Most popular
                </span>
              )}
              <h2 class="text-lg font-semibold text-foreground">{plan.name}</h2>
              <p class="mt-2 min-h-12 text-sm leading-relaxed text-muted-foreground">{plan.description}</p>

              <div class="mt-6 flex items-baseline gap-1.5">
                {plan.monthly !== null && plan.annual !== null ? (
                  <>
                    <span class="text-4xl font-semibold tracking-tight text-foreground group-data-[billing=monthly]/pricing:hidden">
                      {fmt(plan.annual)}
                    </span>
                    <span class="hidden text-4xl font-semibold tracking-tight text-foreground group-data-[billing=monthly]/pricing:inline">
                      {fmt(plan.monthly)}
                    </span>
                    <span class="text-sm text-muted-foreground">/ month</span>
                  </>
                ) : (
                  <span class="text-4xl font-semibold tracking-tight text-foreground">Custom</span>
                )}
              </div>
              <p class="mt-1 h-5 text-xs text-muted-foreground">
                {plan.monthly !== null ? (
                  <>
                    <span class="group-data-[billing=monthly]/pricing:hidden">Billed annually</span>
                    <span class="hidden group-data-[billing=monthly]/pricing:inline">Billed monthly</span>
                  </>
                ) : (
                  'Volume-based annual agreement'
                )}
              </p>

              <Button href={plan.cta.href} variant={plan.highlighted ? 'primary' : 'outline'} class="mt-8 w-full">
                {plan.cta.label}
              </Button>

              <p class="mt-8 text-sm font-medium text-foreground">{plan.includesLabel}</p>
              <ul class="mt-4 space-y-3">
                {plan.features.map((f) => (
                  <li class="flex items-start gap-2.5 text-sm text-muted-foreground">
                    <Check class="mt-0.5 size-4 shrink-0 text-primary" />
                    {f}
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
      <p class="mt-8 text-center text-sm text-muted-foreground">
        Prices in USD, excluding taxes. Nonprofit, academic and public-sector pricing available.
      </p>
    </div>
  </section>

  <!-- Comparison -->
  <section class="border-y border-border bg-muted/40 py-20 sm:py-28">
    <div class="container-page">
      <SectionHeader eyebrow="Compare plans" title="Find the right fit" />
      <div class="mt-14 overflow-hidden rounded-2xl border border-border bg-card shadow-soft">
        <div class="relative overflow-x-auto">
          <table class="w-full min-w-[44rem] text-left text-sm">
            <caption class="sr-only">Feature comparison across plans</caption>
            <thead>
              <tr class="border-b border-border">
                <th scope="col" class="w-2/5 px-6 py-5 font-medium text-muted-foreground">Features</th>
                {
                  plans.map((p) => (
                    <th scope="col" class="px-6 py-5 text-center font-semibold text-foreground">
                      {p.name}
                    </th>
                  ))
                }
              </tr>
            </thead>
            {
              comparison.map((group) => (
                <tbody>
                  <tr class="bg-muted/60">
                    <th colspan="4" scope="colgroup" class="px-6 py-3 text-xs font-semibold tracking-wide text-foreground uppercase">
                      {group.group}
                    </th>
                  </tr>
                  {group.rows.map((row) => (
                    <tr class="border-b border-border last:border-b-0">
                      <th scope="row" class="px-6 py-4 font-normal text-muted-foreground">{row.feature}</th>
                      {row.values.map((v) => (
                        <td class="px-6 py-4 text-center text-foreground">
                          {v === true ? (
                            <>
                              <Check class="mx-auto size-4.5 text-primary" />
                              <span class="sr-only">Included</span>
                            </>
                          ) : v === false ? (
                            <>
                              <Minus class="mx-auto size-4 text-muted-foreground/50" />
                              <span class="sr-only">Not included</span>
                            </>
                          ) : (
                            v
                          )}
                        </td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              ))
            }
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- Add-ons -->
  <section class="py-20 sm:py-24">
    <div class="container-page">
      <SectionHeader eyebrow="Add-ons" title="Extend any plan" description="Pay only for what you need, when you need it." />
      <ul class="mt-14 grid gap-6 md:grid-cols-3">
        {
          addons.map((a) => (
            <li class="rounded-2xl border border-border bg-card p-7 shadow-soft">
              <h3 class="font-semibold text-foreground">{a.title}</h3>
              <p class="mt-1 font-mono text-sm text-primary">{a.price}</p>
              <p class="mt-3 leading-relaxed text-muted-foreground">{a.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <div class="border-t border-border">
    <FAQ items={pricingFaq} title="Pricing questions" />
  </div>
  <CTASection title="Start with a 14-day pilot on your own area" />
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-pricing]');
  const options = document.querySelectorAll<HTMLButtonElement>('[data-billing-option]');
  options.forEach((option) =>
    option.addEventListener('click', () => {
      if (!root) return;
      root.dataset.billing = option.dataset.billingOption;
      options.forEach((o) => o.setAttribute('aria-checked', String(o === option)));
    }),
  );
</script>
