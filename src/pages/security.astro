---
import { EyeOff, FileLock2, HardDrive, KeyRound, Laptop, ListChecks, Trash2, Users } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import CTASection from '../components/sections/CTASection.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import IconBadge from '../components/ui/IconBadge.astro';
import Button from '../components/ui/Button.astro';
import { site } from '../config/site';

const practices = [
  { icon: FileLock2, title: 'NDA before data', description: 'A mutual NDA is in place before we see any network data, screenshots included.' },
  { icon: KeyRound, title: 'Your environment first', description: 'Where possible we work inside your network over VPN, VDI or Citrix, using accounts you create and can switch off.' },
  { icon: HardDrive, title: 'Encrypted copies only', description: 'If data has to come to us, it is kept on encrypted storage, never on personal devices or shared drives.' },
  { icon: Users, title: 'Named people', description: 'Only the people named on your project can open your data, and you can see who they are.' },
  { icon: EyeOff, title: 'No reuse', description: 'Your data is never used for other clients, demos, training material or marketing.' },
  { icon: Trash2, title: 'Deleted at close', description: 'Copies we hold are deleted when the project ends, and we confirm the deletion in writing.' },
  { icon: Laptop, title: 'Managed devices', description: 'Work laptops use full-disk encryption, screen locks and up-to-date software.' },
  { icon: ListChecks, title: 'Your rules on top', description: 'If your security team has its own requirements or questionnaire, we work through it before the project starts.' },
];
---

<BaseLayout title="Data handling" description={`How ${site.name} handles utility network data: NDAs, access in your environment, encrypted storage and deletion at project close.`}>
  <PageHero
    eyebrow="Data handling"
    title="How we look after your network data"
    description="Utility asset data describes critical infrastructure. These are the practices we follow on every project, whatever its size."
  >
    <Fragment slot="actions">
      <Button href={`mailto:${site.email.hello}?subject=Security%20questionnaire`} size="lg">Send us your questionnaire</Button>
    </Fragment>
  </PageHero>

  <section class="py-20 sm:py-28">
    <div class="container-page">
      <SectionHeader eyebrow="On every project" title="Practices, not badges" description="We don’t hold security certifications yet. This is what we do instead, and we put it in writing in each contract." />
      <ul class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          practices.map((p) => (
            <li class="rounded-2xl border border-border bg-card p-7 shadow-soft">
              <IconBadge>
                <p.icon />
              </IconBadge>
              <h3 class="mt-6 font-semibold text-foreground">{p.title}</h3>
              <p class="mt-2 leading-relaxed text-muted-foreground">{p.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CTASection />
</BaseLayout>
