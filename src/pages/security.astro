---
import { BadgeCheck, Eye, FileCheck, Globe, KeyRound, Lock, ScrollText, ServerCog, ShieldCheck, Users } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import CTASection from '../components/sections/CTASection.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import IconBadge from '../components/ui/IconBadge.astro';
import Button from '../components/ui/Button.astro';
import { site } from '../config/site';

const compliance = [
  { name: 'SOC 2 Type II', status: 'Audited annually' },
  { name: 'ISO/IEC 27001', status: 'Certified' },
  { name: 'GDPR', status: 'Compliant · DPA available' },
  { name: 'CCPA', status: 'Compliant' },
];

const pillars = [
  { icon: Lock, title: 'Encryption', description: 'TLS 1.3 for data in transit and AES-256 for data at rest, with keys managed in a hardware-backed KMS. Customer-managed keys available on Enterprise.' },
  { icon: KeyRound, title: 'Access control', description: 'SSO via SAML 2.0 and OIDC, SCIM provisioning, enforced MFA and fine-grained, project-level roles.' },
  { icon: ScrollText, title: 'Audit logging', description: 'Immutable logs of every sign-in, API call, export and permission change, exportable to your SIEM.' },
  { icon: ServerCog, title: 'Flexible deployment', description: 'Multi-tenant cloud, single-tenant, private VPC in your cloud account, or fully air-gapped on-premises.' },
  { icon: Globe, title: 'Data residency', description: 'Choose where imagery, results and metadata are stored and processed: United States, European Union or India.' },
  { icon: Eye, title: 'Responsible AI', description: 'Published model cards, evaluation across regions, and policies that prohibit surveillance of individuals.' },
];

const practices = [
  { icon: ShieldCheck, text: 'Annual third-party penetration tests and continuous vulnerability scanning' },
  { icon: Users, text: 'Background checks and security training for every employee' },
  { icon: FileCheck, text: 'Least-privilege production access with just-in-time approval' },
  { icon: BadgeCheck, text: 'Your data is never used to train shared models without opt-in' },
];
---

<BaseLayout title="Trust & security" description={`How ${site.name} protects your data: compliance, encryption, access control, deployment options and data residency.`}>
  <PageHero
    eyebrow="Trust center"
    title="Security that’s built in, not bolted on"
    description="Your areas of interest, imagery and results can be commercially and operationally sensitive. We protect them with enterprise-grade controls at every layer."
  >
    <Fragment slot="actions">
      <Button href="/contact?topic=sales" size="lg">Request security docs</Button>
      <Button href={`mailto:${site.email.security}`} size="lg" variant="outline">Report a vulnerability</Button>
    </Fragment>
  </PageHero>

  <section class="py-16 sm:py-20">
    <div class="container-page">
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          compliance.map((c) => (
            <li class="flex items-center gap-4 rounded-2xl border border-border bg-card p-5 shadow-soft">
              <span class="grid size-12 shrink-0 place-items-center rounded-full border-2 border-primary/30 bg-primary-soft text-primary-soft-foreground">
                <ShieldCheck class="size-5" />
              </span>
              <span>
                <span class="block font-semibold text-foreground">{c.name}</span>
                <span class="block text-sm text-muted-foreground">{c.status}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="border-y border-border bg-muted/40 py-20 sm:py-28">
    <div class="container-page">
      <SectionHeader eyebrow="Platform security" title="Defense in depth" description="Security controls across infrastructure, application and organization." />
      <ul class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          pillars.map((p) => (
            <li class="rounded-2xl border border-border bg-card p-7 shadow-soft">
              <IconBadge>
                <p.icon />
              </IconBadge>
              <h3 class="mt-6 font-semibold text-foreground">{p.title}</h3>
              <p class="mt-2 leading-relaxed text-muted-foreground">{p.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="py-20 sm:py-28">
    <div class="container-page grid gap-12 lg:grid-cols-2 lg:gap-16">
      <SectionHeader
        align="left"
        eyebrow="Operations"
        title="Secure by practice"
        description="Strong controls only matter if they’re followed every day. Here’s how we operate."
      />
      <ul class="space-y-4">
        {
          practices.map((p) => (
            <li class="flex items-start gap-4 rounded-2xl border border-border bg-card p-5 shadow-soft">
              <p.icon class="mt-0.5 size-5 shrink-0 text-primary" />
              <span class="text-foreground">{p.text}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="container-page mt-16">
      <div class="rounded-2xl border border-border bg-card p-7 shadow-soft sm:p-8">
        <h2 class="text-lg font-semibold text-foreground">Responsible disclosure</h2>
        <p class="mt-2 max-w-3xl text-muted-foreground">
          If you believe you’ve found a security issue, please email{' '}
          <a href={`mailto:${site.email.security}`} class="font-medium text-primary hover:underline">{site.email.security}</a>. We acknowledge
          reports within one business day and will keep you updated until it’s resolved. We don’t pursue legal action against good-faith research.
        </p>
      </div>
    </div>
  </section>

  <CTASection
    title="Need our security package?"
    description="Request our SOC 2 report, penetration test summary, DPA and completed security questionnaires."
    primary={{ label: 'Request documents', href: '/contact?topic=sales' }}
    secondary={{ label: 'Read the privacy policy', href: '/privacy' }}
  />
</BaseLayout>
