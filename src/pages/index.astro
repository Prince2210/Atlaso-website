---
import { ArrowRight, Check, EyeOff, FileLock2, Handshake, KeyRound, Layers, Server, Trash2 } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import IconBadge from '../components/ui/IconBadge.astro';
import NetworkMap from '../components/visuals/NetworkMap.astro';
import FAQ from '../components/sections/FAQ.astro';
import CTASection from '../components/sections/CTASection.astro';
import { process, services } from '../data/services';

const why = [
  { date: 'March 2026', title: 'ArcMap retired', description: 'Editing workflows built on ArcMap now need to run in ArcGIS Pro.' },
  { date: 'In ArcGIS Pro', title: 'Geometric networks are read-only', description: 'Pro can draw a geometric network but not edit one. The Utility Network replaces it.' },
  { date: 'ArcGIS Online', title: 'Web AppBuilder retired', description: 'Apps built on it need rebuilding in Experience Builder or as custom apps.' },
];

const stacks = [
  {
    icon: Layers,
    title: 'On ArcGIS',
    description: 'For teams with Esri licences: the Utility Network in ArcGIS Pro and Enterprise, with apps on Experience Builder or the ArcGIS Maps SDK for JavaScript.',
    tools: ['ArcGIS Pro', 'Utility Network', 'ArcGIS Enterprise', 'Experience Builder', 'ArcGIS Maps SDK for JS'],
  },
  {
    icon: Server,
    title: 'On open source',
    description: 'For teams without Esri licences or that want fewer: PostGIS for the data, GeoServer for the services, OpenLayers or Leaflet for the map.',
    tools: ['PostGIS', 'GeoServer', 'OpenLayers', 'Leaflet', 'QGIS'],
  },
];

const dataHandling = [
  { icon: KeyRound, title: 'Your environment first', description: 'We work over your VPN, VDI or Citrix with accounts you control.' },
  { icon: FileLock2, title: 'NDA before data', description: 'A mutual NDA is signed before we see any network data.' },
  { icon: EyeOff, title: 'No reuse', description: 'Your data is never used for other clients, demos or marketing.' },
  { icon: Trash2, title: 'Deleted at the end', description: 'Any copies we hold are deleted when the project closes, and we confirm it in writing.' },
];

const faq = [
  {
    q: 'Where is your team based?',
    a: 'In Delhi, India. We work with clients in North America, the UK and Australia and keep a few hours of overlap with your working day for calls.',
  },
  {
    q: 'Do you only work on ArcGIS?',
    a: 'Most of our work is on ArcGIS, but we also build on GeoServer, PostGIS, OpenLayers and Leaflet, and can recommend which fits your budget and team.',
  },
  {
    q: 'How do you price projects?',
    a: 'Fixed price per stage, agreed after the assessment. Maintenance is a monthly retainer scoped by edit volume and turnaround.',
  },
  {
    q: 'Can you work under our company name?',
    a: 'Yes. GIS consultancies and Esri partners can use us as white-label delivery capacity. See the page for GIS firms.',
  },
];
---

<BaseLayout>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden">
    <div class="absolute inset-0 -z-10 bg-grid mask-fade-top" aria-hidden="true"></div>
    <div class="absolute -top-48 left-1/2 -z-10 h-[32rem] w-[64rem] -translate-x-1/2 glow" aria-hidden="true"></div>

    <div class="container-page grid items-center gap-14 pt-14 pb-20 sm:pt-20 lg:grid-cols-[1.05fr_1fr] lg:gap-12 lg:pt-24">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full border border-border bg-background/70 px-3 py-1 text-sm text-muted-foreground shadow-soft backdrop-blur">
          <span class="size-1.5 rounded-full bg-primary"></span>
          Utility GIS modernisation
        </p>
        <h1 class="mt-7 text-[2.5rem] leading-[1.05] font-semibold tracking-tight text-foreground sm:text-6xl">
          Get your utility GIS onto the <span class="text-gradient">Utility Network</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg text-muted-foreground sm:text-xl">
          We migrate water, sewer, gas and electric data off the Geometric Network, keep it clean after go-live, and build the web GIS
          apps your crews and planners use. On ArcGIS, or on an open-source stack.
        </p>

        <div class="mt-10 flex flex-col gap-3 sm:flex-row">
          <Button href="/book-a-call" size="lg">
            Book a scoping call
            <ArrowRight class="size-4 transition-transform group-hover/btn:translate-x-0.5" />
          </Button>
          <Button href="/services" size="lg" variant="outline">See services</Button>
        </div>

        <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted-foreground">
          {
            ['Fixed-price stages', 'Pilot before full scope', 'White-label for GIS firms'].map((t) => (
              <li class="flex items-center gap-1.5">
                <Check class="size-4 text-primary" />
                {t}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="relative">
        <div class="absolute -inset-8 -z-10 rounded-[3rem] glow opacity-70" aria-hidden="true"></div>
        <NetworkMap />
      </div>
    </div>
  </section>

  <!-- Why now -->
  <section class="border-y border-border bg-muted/40 py-20 sm:py-24">
    <div class="container-page">
      <SectionHeader
        eyebrow="Why now"
        title="The Esri platform has moved on"
        description="If your network is still edited in ArcMap, the tools around it are already retired or on their way out."
      />
      <ul class="mt-14 grid gap-6 md:grid-cols-3">
        {
          why.map((w) => (
            <li class="rounded-2xl border border-border bg-card p-7 shadow-soft">
              <span class="font-mono text-xs text-primary">{w.date}</span>
              <h3 class="mt-3 text-lg font-semibold text-foreground">{w.title}</h3>
              <p class="mt-2 leading-relaxed text-muted-foreground">{w.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Services -->
  <section class="py-20 sm:py-28">
    <div class="container-page">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <SectionHeader
          align="left"
          eyebrow="Services"
          title="Migrate the data, then build on it"
          description="Take one service or all four. Each starts with an assessment and a fixed price."
        />
        <Button href="/services" variant="outline" class="self-start md:self-auto">
          All services <ArrowRight class="size-4" />
        </Button>
      </div>
      <ul class="mt-14 grid gap-5 sm:grid-cols-2">
        {
          services.map((s) => (
            <li>
              <a
                href={`/services/${s.slug}`}
                class="group flex h-full flex-col rounded-2xl border border-border bg-card p-7 shadow-soft transition duration-200 hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-elevated"
              >
                <IconBadge>
                  <s.icon />
                </IconBadge>
                <h3 class="mt-6 text-lg font-semibold text-foreground">{s.name}</h3>
                <p class="mt-2 flex-1 leading-relaxed text-muted-foreground">{s.summary}</p>
                <ul class="mt-5 flex flex-wrap gap-2">
                  {s.stack.slice(0, 4).map((t) => (
                    <li class="rounded-md border border-border bg-background px-2 py-1 font-mono text-xs text-muted-foreground">{t}</li>
                  ))}
                </ul>
                <span class="mt-6 inline-flex items-center gap-1 text-sm font-medium text-primary">
                  Learn more <ArrowRight class="size-4 transition-transform group-hover:translate-x-0.5" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Two stacks -->
  <section class="border-y border-border bg-muted/40 py-20 sm:py-28">
    <div class="container-page">
      <SectionHeader
        eyebrow="Your platform"
        title="ArcGIS or open source"
        description="We recommend the stack that fits your licences, budget and team, and say so when the other one fits better."
      />
      <ul class="mt-14 grid gap-6 lg:grid-cols-2">
        {
          stacks.map((s) => (
            <li class="rounded-2xl border border-border bg-card p-8 shadow-soft">
              <IconBadge>
                <s.icon />
              </IconBadge>
              <h3 class="mt-6 text-xl font-semibold text-foreground">{s.title}</h3>
              <p class="mt-2 leading-relaxed text-muted-foreground">{s.description}</p>
              <ul class="mt-6 flex flex-wrap gap-2">
                {s.tools.map((t) => (
                  <li class="rounded-md border border-border bg-background px-2 py-1 font-mono text-xs text-muted-foreground">{t}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Process -->
  <section id="process" class="scroll-mt-16 py-20 sm:py-28">
    <div class="container-page">
      <SectionHeader
        eyebrow="How we work"
        title="Small steps, fixed prices"
        description="You see the quality of our work on a pilot before you commit to the full scope."
      />
      <ol class="mt-16 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {
          process.map((step, i) => (
            <li class="rounded-2xl border border-border bg-card p-7 shadow-soft">
              <span class="font-mono text-sm text-primary">0{i + 1}</span>
              <h3 class="mt-4 text-lg font-semibold text-foreground">{step.title}</h3>
              <p class="mt-2 leading-relaxed text-muted-foreground">{step.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Partners -->
  <section class="border-y border-border bg-muted/40 py-20 sm:py-24">
    <div class="container-page grid items-center gap-10 lg:grid-cols-[1.2fr_1fr] lg:gap-16">
      <div>
        <SectionHeader
          align="left"
          eyebrow="For GIS firms and Esri partners"
          title="Extra delivery capacity, under your name"
          description="When a Utility Network project needs more hands than your team has, we work as part of it: your client, your processes, your brand."
        />
        <div class="mt-8">
          <Button href="/partners" variant="outline">
            How partnering works <ArrowRight class="size-4" />
          </Button>
        </div>
      </div>
      <ul class="space-y-4">
        {
          ['We never contact your clients directly', 'Work follows your QA checklists and naming standards', 'Overnight turnaround for teams in North America, the UK and Australia'].map((t) => (
            <li class="flex items-start gap-3 rounded-2xl border border-border bg-card p-5 shadow-soft">
              <Handshake class="mt-0.5 size-5 shrink-0 text-primary" />
              <span class="text-foreground">{t}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Data handling -->
  <section class="py-20 sm:py-28">
    <div class="container-page">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <SectionHeader
          align="left"
          eyebrow="Your data"
          title="Network data is sensitive. We treat it that way."
          description="Utility asset data is critical infrastructure information. Here is how we handle it on every project."
        />
        <Button href="/security" variant="outline" class="self-start md:self-auto">
          Data handling <ArrowRight class="size-4" />
        </Button>
      </div>
      <ul class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          dataHandling.map((d) => (
            <li class="rounded-2xl border border-border bg-card p-6 shadow-soft">
              <d.icon class="size-6 text-primary" />
              <h3 class="mt-5 font-semibold text-foreground">{d.title}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{d.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <div class="border-t border-border">
    <FAQ items={faq} />
  </div>

  <CTASection />
</BaseLayout>
