---
import { Headphones, MapPin, Newspaper, Briefcase } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/sections/LeadForm.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import { offices } from '../data/company';
import { features, site } from '../config/site';

const channels = [
  { icon: Briefcase, title: 'Sales', description: 'Pricing, pilots and enterprise plans.', email: site.email.sales },
  { icon: Headphones, title: 'Support', description: `Help with your workspace${features.developers ? ' or the API' : ''}.`, email: site.email.support },
  { icon: Newspaper, title: 'Press', description: 'Media enquiries and brand assets.', email: site.email.press },
];
---

<BaseLayout title="Contact" description={`Get in touch with the ${site.name} team — sales, support, partnerships and press.`}>
  <section class="relative isolate overflow-hidden">
    <div class="absolute inset-0 -z-10 bg-grid mask-fade-top" aria-hidden="true"></div>
    <div class="absolute -top-40 left-1/4 -z-10 h-80 w-[40rem] glow" aria-hidden="true"></div>
    <div class="container-page grid gap-12 py-16 sm:py-20 lg:grid-cols-[1fr_1.15fr] lg:gap-16 lg:py-24">
      <div>
        <Eyebrow class="mb-4">Contact</Eyebrow>
        <h1 class="text-4xl leading-[1.08] font-semibold text-foreground sm:text-5xl">Let’s talk</h1>
        <p class="mt-6 max-w-lg text-lg text-muted-foreground">
          Questions about the platform, pricing or partnering with us? Send a message and the right person will get back to you within
          one business day.
        </p>

        <ul class="mt-10 space-y-4">
          {
            channels.map((c) => (
              <li class="flex gap-4 rounded-2xl border border-border bg-card p-5 shadow-soft">
                <c.icon class="mt-0.5 size-5 shrink-0 text-primary" />
                <div>
                  <h2 class="font-medium text-foreground">{c.title}</h2>
                  <p class="text-sm text-muted-foreground">{c.description}</p>
                  <a href={`mailto:${c.email}`} class="mt-1 inline-block text-sm font-medium text-primary hover:underline">
                    {c.email}
                  </a>
                </div>
              </li>
            ))
          }
        </ul>

        <h2 class="mt-12 text-sm font-semibold text-foreground">Offices</h2>
        <ul class="mt-4 grid gap-4 sm:grid-cols-3">
          {
            offices.map((o) => (
              <li class="text-sm">
                <span class="flex items-center gap-1.5 font-medium text-foreground">
                  <MapPin class="size-4 text-primary" />
                  {o.city}
                </span>
                <span class="mt-1 block text-muted-foreground">{o.address}</span>
                <span class="block text-muted-foreground">{o.country}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <LeadForm variant="contact" class="lg:sticky lg:top-24 lg:mt-2 lg:self-start" />
    </div>
  </section>
</BaseLayout>
