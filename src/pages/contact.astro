---
import { Mail, MapPin } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/sections/LeadForm.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import { site } from '../config/site';
---

<BaseLayout title="Contact" description={`Get in touch with ${site.name} about Utility Network migration, GIS data maintenance or web GIS apps.`}>
  <section class="relative isolate overflow-hidden">
    <div class="absolute inset-0 -z-10 bg-grid mask-fade-top" aria-hidden="true"></div>
    <div class="absolute -top-40 left-1/4 -z-10 h-80 w-[40rem] glow" aria-hidden="true"></div>
    <div class="container-page grid gap-12 py-16 sm:py-20 lg:grid-cols-[1fr_1.15fr] lg:gap-16 lg:py-24">
      <div>
        <Eyebrow class="mb-4">Contact</Eyebrow>
        <h1 class="text-4xl leading-[1.08] font-semibold text-foreground sm:text-5xl">Let’s talk</h1>
        <p class="mt-6 max-w-lg text-lg text-muted-foreground">
          Questions about a migration, an app or working with us as a partner? Send a message and we’ll reply within one business day.
        </p>

        <ul class="mt-10 space-y-4">
          <li class="flex gap-4 rounded-2xl border border-border bg-card p-5 shadow-soft">
            <Mail class="mt-0.5 size-5 shrink-0 text-primary" />
            <div>
              <h2 class="font-medium text-foreground">Email</h2>
              <p class="text-sm text-muted-foreground">Projects, partnering and anything else.</p>
              <a href={`mailto:${site.email.hello}`} class="mt-1 inline-block text-sm font-medium text-primary hover:underline">
                {site.email.hello}
              </a>
            </div>
          </li>
          <li class="flex gap-4 rounded-2xl border border-border bg-card p-5 shadow-soft">
            <MapPin class="mt-0.5 size-5 shrink-0 text-primary" />
            <div>
              <h2 class="font-medium text-foreground">Delhi, India</h2>
              <p class="text-sm text-muted-foreground">Working with clients in North America, the UK and Australia.</p>
            </div>
          </li>
        </ul>

        <p class="mt-10 text-sm text-muted-foreground">
          Ready to scope a project? <a href="/book-a-call" class="font-medium text-primary hover:underline">Book a scoping call</a> instead.
        </p>
      </div>

      <LeadForm variant="contact" class="lg:sticky lg:top-24 lg:mt-2 lg:self-start" />
    </div>
  </section>
</BaseLayout>
