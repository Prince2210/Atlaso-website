---
import { ArrowRight, Sparkles } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import FeatureRow from '../components/sections/FeatureRow.astro';
import FAQ from '../components/sections/FAQ.astro';
import CTASection from '../components/sections/CTASection.astro';
import Button from '../components/ui/Button.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import CodeTabs from '../components/ui/CodeTabs.astro';
import PlatformDiagram from '../components/visuals/PlatformDiagram.astro';
import SatelliteScene from '../components/visuals/SatelliteScene.astro';
import BeforeAfter from '../components/visuals/BeforeAfter.astro';
import { features, product } from '../config/site';
import { models } from '../data/models';
import { responseSample } from '../data/code';

const taskTone: Record<string, string> = {
  Detection: 'bg-amber-500/10 text-amber-700 dark:text-amber-300 border-amber-500/20',
  Segmentation: 'bg-sky-500/10 text-sky-700 dark:text-sky-300 border-sky-500/20',
  Change: 'bg-rose-500/10 text-rose-700 dark:text-rose-300 border-rose-500/20',
  Classification: 'bg-violet-500/10 text-violet-700 dark:text-violet-300 border-violet-500/20',
  Regression: 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border-emerald-500/20',
};

const formats = ['GeoJSON', 'GeoParquet', 'Cloud-Optimized GeoTIFF', 'STAC', 'WMS / WMTS', 'Vector tiles', 'CSV', 'Shapefile'];

const faq = [
  {
    q: `What imagery does ${product.name} use?`,
    a: 'We work with a network of open and commercial providers covering optical (30 cm to 10 m), SAR, aerial and drone imagery. You can also bring your own imagery via cloud storage or upload. We handle ordering, harmonization and cloud masking for you.',
  },
  {
    q: 'How accurate are the models?',
    a: 'Every model in the catalog ships with published evaluation metrics on held-out, geographically diverse test sets. You can also run an evaluation on your own labeled data before going to production, and track performance over time.',
  },
  {
    q: 'Can I train models for my own objects?',
    a: 'Yes. Because our models are built on a geospatial foundation model, you can fine-tune a new detector or segmenter with as few as 30 labeled examples using the built-in labeling tool — no ML expertise required.',
  },
  {
    q: 'How does natural-language search work?',
    a: `${product.shortName} translates your question into a geospatial query plan — which areas, time ranges, models and statistics to use — runs it, and returns an answer with links to the exact scenes and features used as evidence.`,
  },
  {
    q: 'Does it work with our existing GIS tools?',
    a: `Results are standard geospatial formats and services, so they open directly in desktop GIS, web maps, notebooks and data warehouses.${features.developers ? ' Webhooks and the API let you push insights into any internal system.' : ''}`,
  },
];
---

<BaseLayout title={product.name} description={product.description}>
  <PageHero eyebrow={product.name} title={product.tagline} description={product.description}>
    <Fragment slot="actions">
      <Button href="/demo" size="lg">Book a demo <ArrowRight class="size-4" /></Button>
      <Button href="/pricing" size="lg" variant="outline">See pricing</Button>
    </Fragment>
    <div class="mx-auto mt-16 max-w-6xl">
      <PlatformDiagram />
    </div>
  </PageHero>

  <section id="capabilities" class="scroll-mt-16 py-20 sm:py-28">
    <div class="container-page space-y-24 sm:space-y-32">
      <FeatureRow
        eyebrow="Detect & segment"
        title="Find every object that matters, at any scale"
        description="Run production-grade detection and segmentation across a city block or a continent. Results are georeferenced, versioned and ready to analyze."
        bullets={['40+ pre-trained models', 'Fine-tune with 30 labels', 'Confidence on every feature', 'Sub-meter to 10 m imagery']}
      >
        <div class="relative aspect-[4/3] overflow-hidden rounded-2xl border border-border bg-[#0a2233] shadow-elevated">
          <SatelliteScene uid="product-detect" overlays viewBox="500 70 300 225" class="absolute inset-0 size-full" />
          <div class="absolute bottom-3 left-3 flex flex-wrap gap-1.5">
            <span class="rounded-md bg-slate-950/75 px-2 py-1 font-mono text-[10px] text-amber-300 backdrop-blur">■ 6 vessels</span>
            <span class="rounded-md bg-slate-950/75 px-2 py-1 font-mono text-[10px] text-violet-300 backdrop-blur">■ 1 container yard</span>
          </div>
        </div>
      </FeatureRow>

      <FeatureRow
        reverse
        eyebrow="Monitor change"
        title="Continuous monitoring with less noise"
        description="Set up a monitor once and get notified only when something meaningful changes. Our change engine understands seasons, shadows, clouds and sensor differences."
        bullets={['Optical + SAR fusion', 'Seasonal baselines', 'Per-object change history', `Alerts via email, Slack${features.developers ? ' or webhook' : ' or Teams'}`]}
      >
        <BeforeAfter uid="product-ba" />
      </FeatureRow>

      <FeatureRow
        eyebrow="Ask"
        title="Ask questions in plain language"
        description={`${product.shortName} plans and runs the geospatial analysis for you, then answers with numbers, maps and the evidence behind them — so anyone on your team can get answers without writing a query.`}
        bullets={['Grounded in your imagery', 'Cites scenes & models used', 'Answers as maps, charts or tables', 'Save questions as monitors']}
      >
        <div class="rounded-2xl border border-border bg-card p-5 shadow-elevated sm:p-6" aria-hidden="true">
          <div class="flex items-center gap-2 border-b border-border pb-4 text-sm font-medium text-foreground">
            <Sparkles class="size-4 text-primary" /> Ask {product.shortName}
            <span class="ml-auto font-mono text-[11px] font-normal text-muted-foreground">AOI · Rotterdam port</span>
          </div>
          <div class="space-y-4 pt-5 text-sm">
            <p class="ml-auto w-fit max-w-[85%] rounded-xl rounded-br-sm bg-foreground px-3.5 py-2.5 text-background">
              Compare vessel activity this quarter to the same quarter last year.
            </p>
            <div class="max-w-[92%] space-y-3 rounded-xl rounded-bl-sm border border-border bg-muted/60 px-4 py-3.5 text-foreground">
              <p>Average daily vessels at anchor rose from <strong>41</strong> to <strong>53</strong> (+29%). The busiest week was 8–14 Sep.</p>
              <div class="flex h-20 items-end gap-1">
                {
                  [38, 41, 40, 44, 39, 43, 47, 52, 49, 55, 58, 53].map((h, i) => (
                    <span class:list={['flex-1 rounded-t-[3px]', i < 6 ? 'bg-foreground/20' : 'bg-primary']} style={`height:${h + 30}%`} />
                  ))
                }
              </div>
              <p class="flex flex-wrap gap-1.5">
                <span class="rounded-md border border-border bg-background px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground">vessels-v3</span>
                <span class="rounded-md border border-border bg-background px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground">184 scenes</span>
                <span class="rounded-md border border-border bg-background px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground">conf 0.95</span>
              </p>
            </div>
          </div>
        </div>
      </FeatureRow>

      {
        features.developers && (
          <FeatureRow
            reverse
            eyebrow="Integrate"
            title="Insights where your team already works"
            description="Every result is a standard geospatial asset with a stable ID. Pull it via API, stream it into your warehouse or open it in your favourite GIS."
            bullets={['REST API & typed SDKs', 'Webhooks for every event', 'OGC-compliant tile services', 'Warehouse-friendly exports']}
          >
            <CodeTabs samples={[responseSample]} title="POST /v1/ask → 200 OK" />
          </FeatureRow>
        )
      }
    </div>
  </section>

  <!-- Model catalog -->
  <section id="models" class="scroll-mt-16 border-y border-border bg-muted/40 py-20 sm:py-28">
    <div class="container-page">
      <SectionHeader
        eyebrow="Model catalog"
        title="Production-ready models, with honest metrics"
        description="A selection of our most-used models. Each is evaluated on geographically diverse, held-out test sets — and you can benchmark on your own data before you buy."
      />
      <div class="mt-14 overflow-hidden rounded-2xl border border-border bg-card shadow-soft">
        <div class="relative overflow-x-auto">
          <table class="w-full min-w-[40rem] text-left text-sm">
            <thead class="border-b border-border bg-muted/60 text-xs tracking-wide text-muted-foreground uppercase">
              <tr>
                <th scope="col" class="px-5 py-3.5 font-medium">Model</th>
                <th scope="col" class="px-5 py-3.5 font-medium">Task</th>
                <th scope="col" class="px-5 py-3.5 font-medium">Sensors</th>
                <th scope="col" class="px-5 py-3.5 font-medium">Resolution</th>
                <th scope="col" class="px-5 py-3.5 text-right font-medium">Benchmark</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border">
              {
                models.map((m) => (
                  <tr class="transition-colors hover:bg-muted/50">
                    <th scope="row" class="px-5 py-4 font-medium text-foreground">{m.name}</th>
                    <td class="px-5 py-4">
                      <span class:list={['inline-flex rounded-full border px-2 py-0.5 text-xs font-medium', taskTone[m.task]]}>{m.task}</span>
                    </td>
                    <td class="px-5 py-4 text-muted-foreground">{m.sensors}</td>
                    <td class="px-5 py-4 font-mono text-xs text-muted-foreground">{m.resolution}</td>
                    <td class="px-5 py-4 text-right font-mono text-xs text-foreground">{m.metric}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
      <p class="mt-6 text-center text-sm text-muted-foreground">
        Need something else? <a href="/contact?topic=custom-model" class="font-medium text-primary hover:underline">Ask about custom models</a>.
      </p>
    </div>
  </section>

  <!-- Formats -->
  <section class="py-16 sm:py-20">
    <div class="container-page text-center">
      <p class="text-sm font-medium text-muted-foreground">Works with open standards your stack already speaks</p>
      <ul class="mx-auto mt-6 flex max-w-4xl flex-wrap justify-center gap-2.5">
        {formats.map((f) => <li class="rounded-full border border-border bg-card px-4 py-1.5 font-mono text-xs text-foreground shadow-soft">{f}</li>)}
      </ul>
    </div>
  </section>

  <FAQ items={faq} />
  <CTASection />
</BaseLayout>
