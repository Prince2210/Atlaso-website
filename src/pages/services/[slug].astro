---
import { ArrowRight, CircleAlert } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/sections/CTASection.astro';
import FAQ from '../../components/sections/FAQ.astro';
import Button from '../../components/ui/Button.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import IconBadge from '../../components/ui/IconBadge.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import { process, services, type Service } from '../../data/services';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props {
  service: Service;
}

const { service } = Astro.props;
const others = services.filter((s) => s.slug !== service.slug);
const Icon = service.icon;
---

<BaseLayout title={service.name} description={service.hero.description}>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden border-b border-border">
    <div class="absolute inset-0 -z-10 bg-grid mask-fade-top" aria-hidden="true"></div>
    <div class="absolute -top-40 left-1/2 -z-10 h-80 w-[48rem] -translate-x-1/2 glow" aria-hidden="true"></div>
    <div class="container-page py-16 sm:py-20 lg:py-24">
      <nav aria-label="Breadcrumb" class="mb-8 text-sm text-muted-foreground">
        <a href="/services" class="hover:text-foreground">Services</a>
        <span class="mx-2">/</span>
        <span class="text-foreground">{service.name}</span>
      </nav>
      <div class="max-w-3xl">
        <div class="mb-5 flex items-center gap-3">
          <IconBadge><Icon /></IconBadge>
          <Eyebrow>{service.name}</Eyebrow>
        </div>
        <h1 class="text-4xl leading-[1.08] font-semibold text-foreground sm:text-5xl lg:text-[3.5rem]">{service.hero.title}</h1>
        <p class="mt-6 text-lg text-muted-foreground sm:text-xl">{service.hero.description}</p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <Button href={`/book-a-call?topic=${service.slug}`} size="lg">Book a scoping call <ArrowRight class="size-4" /></Button>
          <Button href="/#process" size="lg" variant="outline">How we work</Button>
        </div>
        <ul class="mt-10 flex flex-wrap gap-2">
          {service.stack.map((t) => <li class="rounded-md border border-border bg-background px-2 py-1 font-mono text-xs text-muted-foreground">{t}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- Context -->
  <section class="py-20 sm:py-28">
    <div class="container-page">
      <SectionHeader eyebrow="The problem" title="Why teams call us" />
      <ul class="mt-14 grid gap-6 md:grid-cols-3">
        {
          service.context.map((c) => (
            <li class="rounded-2xl border border-border bg-card p-7 shadow-soft">
              <CircleAlert class="size-6 text-amber-500" />
              <h3 class="mt-5 text-lg font-semibold text-foreground">{c.title}</h3>
              <p class="mt-2 leading-relaxed text-muted-foreground">{c.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Deliverables -->
  <section class="border-y border-border bg-muted/40 py-20 sm:py-28">
    <div class="container-page grid gap-12 lg:grid-cols-[1fr_1.6fr] lg:gap-16">
      <SectionHeader
        align="left"
        eyebrow="What you get"
        title="Deliverables"
        description="The exact scope is fixed after the assessment, so you know what you are paying for before work starts."
      />
      <ul class="grid gap-5 sm:grid-cols-2">
        {
          service.deliverables.map((d, i) => (
            <li class="rounded-2xl border border-border bg-card p-6 shadow-soft">
              <span class="font-mono text-xs text-primary">0{i + 1}</span>
              <h3 class="mt-3 font-semibold text-foreground">{d.title}</h3>
              <p class="mt-2 text-[0.95rem] leading-relaxed text-muted-foreground">{d.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Process -->
  <section class="py-20 sm:py-24">
    <div class="container-page">
      <SectionHeader eyebrow="How it runs" title="Four stages, each with a fixed price" />
      <ol class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {
          process.map((step, i) => (
            <li class="rounded-2xl border border-border bg-card p-6 shadow-soft">
              <span class="font-mono text-sm text-primary">0{i + 1}</span>
              <h3 class="mt-3 font-semibold text-foreground">{step.title}</h3>
              <p class="mt-2 text-[0.95rem] leading-relaxed text-muted-foreground">{step.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <div class="border-t border-border">
    <FAQ items={service.faq} title={`${service.name}: common questions`} />
  </div>

  <!-- Other services -->
  <section class="pb-4">
    <div class="container-page">
      <h2 class="text-lg font-semibold text-foreground">Other services</h2>
      <ul class="mt-6 grid gap-4 md:grid-cols-3">
        {
          others.map((s) => (
            <li>
              <a
                href={`/services/${s.slug}`}
                class="group flex items-center gap-4 rounded-2xl border border-border bg-card p-5 shadow-soft transition hover:border-primary/40"
              >
                <IconBadge>
                  <s.icon />
                </IconBadge>
                <span class="font-medium text-foreground">{s.name}</span>
                <ArrowRight class="ml-auto size-4 text-muted-foreground transition group-hover:translate-x-0.5 group-hover:text-primary" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CTASection />
</BaseLayout>
