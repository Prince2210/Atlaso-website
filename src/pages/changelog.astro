---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import { changelog, type ChangeTag } from '../data/changelog';
import { formatDate } from '../lib/blog';
import { product } from '../config/site';

const tagTone: Record<ChangeTag, string> = {
  New: 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border-emerald-500/20',
  Improved: 'bg-sky-500/10 text-sky-700 dark:text-sky-300 border-sky-500/20',
  Fixed: 'bg-amber-500/10 text-amber-700 dark:text-amber-300 border-amber-500/20',
};
---

<BaseLayout title="Changelog" description={`New features, improvements and fixes in ${product.name}.`}>
  <PageHero eyebrow="Changelog" title="What’s new" description={`New features, improvements and fixes shipped to ${product.name}.`} />

  <section class="py-16 sm:py-24">
    <div class="container-page max-w-4xl">
      <ol class="relative space-y-14 border-l border-border pl-8 sm:pl-10">
        {
          changelog.map((entry) => (
            <li class="relative">
              <span class="absolute top-1.5 -left-[2.3rem] size-3 rounded-full border-2 border-background bg-primary ring-4 ring-primary/15 sm:-left-[2.8rem]" />
              <p class="flex flex-wrap items-center gap-3 text-sm">
                <span class="rounded-md border border-border bg-muted px-2 py-0.5 font-mono text-xs text-foreground">v{entry.version}</span>
                <time datetime={entry.date} class="text-muted-foreground">
                  {formatDate(new Date(entry.date))}
                </time>
              </p>
              <h2 class="mt-3 text-2xl font-semibold text-foreground">{entry.title}</h2>
              <p class="mt-2 leading-relaxed text-muted-foreground">{entry.summary}</p>
              <ul class="mt-6 space-y-3 rounded-2xl border border-border bg-card p-5 shadow-soft">
                {entry.changes.map((c) => (
                  <li class="flex items-start gap-3 text-[0.95rem] text-foreground">
                    <span class:list={['mt-0.5 w-20 shrink-0 rounded-full border px-2 py-0.5 text-center text-xs font-medium', tagTone[c.tag]]}>
                      {c.tag}
                    </span>
                    {c.text}
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</BaseLayout>
