---
import { ArrowUpRight, Clock, MapPin } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import Button from '../components/ui/Button.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import { perks, roles } from '../data/company';
import { site } from '../config/site';

const teams = [...new Set(roles.map((r) => r.team))];

const process = [
  { title: 'Intro call', description: '30 minutes with the hiring manager about the role and what you’re looking for.' },
  { title: 'Skills deep-dive', description: 'A practical, paid exercise or technical conversation — no trick questions.' },
  { title: 'Team interviews', description: 'Meet future teammates and learn how we work day to day.' },
  { title: 'Offer', description: 'We aim to make a decision within two weeks of your first call.' },
];

const mailto = (title: string) => `mailto:${site.email.careers}?subject=${encodeURIComponent(`Application: ${title}`)}`;
---

<BaseLayout title="Careers" description={`Join ${site.name} and help build AI that makes the planet legible.`}>
  <PageHero
    eyebrow="Careers"
    title="Do the most important work of your career"
    description="We’re a small, senior team building AI that helps the world see what’s changing. Join us if you care about hard problems, craft and impact."
  >
    <Fragment slot="actions">
      <Button href="#roles" size="lg">See open roles</Button>
      <Button href="/about" size="lg" variant="outline">About {site.name}</Button>
    </Fragment>
  </PageHero>

  <section class="py-20 sm:py-28">
    <div class="container-page">
      <SectionHeader eyebrow="Benefits" title="We take care of our people" />
      <ul class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          perks.map((p) => (
            <li class="rounded-2xl border border-border bg-card p-7 shadow-soft">
              <h3 class="font-semibold text-foreground">{p.title}</h3>
              <p class="mt-2 leading-relaxed text-muted-foreground">{p.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="roles" class="scroll-mt-16 border-y border-border bg-muted/40 py-20 sm:py-28">
    <div class="container-page">
      <SectionHeader eyebrow="Open roles" title={`${roles.length} open positions`} description="Don’t see the right role? We’d still love to hear from you." />
      <div class="mx-auto mt-14 max-w-4xl space-y-10">
        {
          teams.map((team) => (
            <div>
              <h3 class="text-sm font-semibold tracking-wide text-muted-foreground uppercase">{team}</h3>
              <ul class="mt-4 divide-y divide-border overflow-hidden rounded-2xl border border-border bg-card shadow-soft">
                {roles
                  .filter((r) => r.team === team)
                  .map((r) => (
                    <li>
                      <a
                        href={mailto(r.title)}
                        class="group flex flex-col gap-2 px-6 py-5 transition-colors hover:bg-muted/60 sm:flex-row sm:items-center sm:gap-6"
                      >
                        <span class="font-medium text-foreground group-hover:text-primary">{r.title}</span>
                        <span class="flex items-center gap-4 text-sm text-muted-foreground sm:ml-auto">
                          <span class="flex items-center gap-1.5">
                            <MapPin class="size-4" />
                            {r.location}
                          </span>
                          <span class="flex items-center gap-1.5">
                            <Clock class="size-4" />
                            {r.type}
                          </span>
                          <ArrowUpRight class="hidden size-4 transition group-hover:text-primary sm:block" />
                        </span>
                      </a>
                    </li>
                  ))}
              </ul>
            </div>
          ))
        }
        <p class="text-center text-muted-foreground">
          Send a general application to <a href={`mailto:${site.email.careers}`} class="font-medium text-primary hover:underline">{site.email.careers}</a>
        </p>
      </div>
    </div>
  </section>

  <section class="py-20 sm:py-28">
    <div class="container-page">
      <SectionHeader eyebrow="Hiring process" title="Clear, respectful and fast" />
      <ol class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          process.map((p, i) => (
            <li class="relative rounded-2xl border border-border bg-card p-7 shadow-soft">
              <span class="grid size-8 place-items-center rounded-full bg-primary-soft text-sm font-semibold text-primary-soft-foreground">{i + 1}</span>
              <h3 class="mt-5 font-semibold text-foreground">{p.title}</h3>
              <p class="mt-2 leading-relaxed text-muted-foreground">{p.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</BaseLayout>
