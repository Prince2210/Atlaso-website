---
import { ArrowRight } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import PostCover from '../../components/ui/PostCover.astro';
import { formatDate, getPosts, readingTime } from '../../lib/blog';
import { site } from '../../config/site';

const posts = await getPosts();
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p !== featured);
---

<BaseLayout title="Blog" description={`Research, guides and product news from the ${site.name} team.`}>
  <PageHero
    eyebrow="Blog"
    title="Notes from the edge of Earth observation"
    description="Research, practical guides and product news from the team building geospatial AI."
  />

  <section class="py-16 sm:py-20">
    <div class="container-page">
      {
        featured && (
          <a
            href={`/blog/${featured.id}`}
            class="group grid overflow-hidden rounded-3xl border border-border bg-card shadow-soft transition hover:border-primary/40 hover:shadow-elevated lg:grid-cols-2"
          >
            <PostCover category={featured.data.category} seed={featured.id} class="aspect-[16/9] lg:aspect-auto lg:min-h-80" />
            <div class="flex flex-col p-7 sm:p-10">
              <p class="flex items-center gap-3 text-sm">
                <span class="rounded-full bg-primary-soft px-2.5 py-0.5 text-xs font-semibold text-primary-soft-foreground">
                  {featured.data.category}
                </span>
                <span class="text-muted-foreground">{formatDate(featured.data.pubDate)}</span>
              </p>
              <h2 class="mt-5 text-2xl font-semibold text-foreground group-hover:text-primary sm:text-3xl">{featured.data.title}</h2>
              <p class="mt-4 leading-relaxed text-muted-foreground">{featured.data.description}</p>
              <p class="mt-auto flex items-center justify-between pt-8 text-sm">
                <span>
                  <span class="font-medium text-foreground">{featured.data.author}</span>
                  <span class="text-muted-foreground"> · {readingTime(featured.body)}</span>
                </span>
                <span class="inline-flex items-center gap-1 font-medium text-primary">
                  Read <ArrowRight class="size-4 transition-transform group-hover:translate-x-0.5" />
                </span>
              </p>
            </div>
          </a>
        )
      }

      <ul class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          rest.map((post) => (
            <li>
              <a
                href={`/blog/${post.id}`}
                class="group flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-card shadow-soft transition hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-elevated"
              >
                <PostCover category={post.data.category} seed={post.id} class="aspect-[16/9]" />
                <div class="flex flex-1 flex-col p-6">
                  <p class="flex items-center gap-3 text-xs">
                    <span class="font-semibold text-primary">{post.data.category}</span>
                    <span class="text-muted-foreground">{formatDate(post.data.pubDate)}</span>
                  </p>
                  <h2 class="mt-3 text-lg leading-snug font-semibold text-foreground group-hover:text-primary">{post.data.title}</h2>
                  <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-muted-foreground">{post.data.description}</p>
                  <p class="mt-auto pt-6 text-sm text-muted-foreground">
                    <span class="font-medium text-foreground">{post.data.author}</span> · {readingTime(post.body)}
                  </p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
