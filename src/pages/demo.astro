---
import { Check } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/sections/LeadForm.astro';
import LogoCloud from '../components/sections/LogoCloud.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import { testimonials } from '../data/testimonials';
import { product } from '../config/site';

const expectations = [
  { title: 'A walkthrough on your geography', description: 'We’ll run live detections and change analysis on an area you choose.' },
  { title: 'Answers to your use case', description: 'See which models, cadences and alerts fit your workflow and data.' },
  { title: 'A clear path to a pilot', description: 'Scope, success criteria and pricing for a 14-day pilot on your data.' },
];

const quote = testimonials[1];
---

<BaseLayout title="Book a demo" description={`See ${product.name} on your own area of interest in a 30-minute personalized demo.`}>
  <section class="relative isolate overflow-hidden">
    <div class="absolute inset-0 -z-10 bg-grid mask-fade-top" aria-hidden="true"></div>
    <div class="absolute -top-40 left-1/4 -z-10 h-80 w-[40rem] glow" aria-hidden="true"></div>
    <div class="container-page grid gap-12 py-16 sm:py-20 lg:grid-cols-[1fr_1.1fr] lg:gap-16 lg:py-24">
      <div>
        <Eyebrow class="mb-4">Book a demo</Eyebrow>
        <h1 class="text-4xl leading-[1.08] font-semibold text-foreground sm:text-5xl">See {product.name} on your own area of interest</h1>
        <p class="mt-6 max-w-lg text-lg text-muted-foreground">
          In 30 minutes, a solutions engineer will show you what’s happening across the places you care about — and how your team could
          act on it.
        </p>

        <ul class="mt-10 space-y-6">
          {
            expectations.map((e) => (
              <li class="flex gap-4">
                <span class="grid size-7 shrink-0 place-items-center rounded-full bg-primary-soft text-primary-soft-foreground">
                  <Check class="size-4" />
                </span>
                <span>
                  <span class="block font-medium text-foreground">{e.title}</span>
                  <span class="mt-0.5 block text-muted-foreground">{e.description}</span>
                </span>
              </li>
            ))
          }
        </ul>

        <figure class="mt-12 rounded-2xl border border-border bg-card p-6 shadow-soft">
          <blockquote class="text-foreground">“{quote.quote}”</blockquote>
          <figcaption class="mt-5 flex items-center gap-3">
            <span class:list={['grid size-9 place-items-center rounded-full text-xs font-semibold text-white', quote.color]}>{quote.initials}</span>
            <span class="text-sm">
              <span class="block font-medium text-foreground">{quote.name}</span>
              <span class="text-muted-foreground">{quote.role}, {quote.company}</span>
            </span>
          </figcaption>
        </figure>
      </div>

      <LeadForm variant="demo" class="lg:sticky lg:top-24 lg:self-start" />
    </div>

    <div class="container-page border-t border-border py-14">
      <LogoCloud />
    </div>
  </section>
</BaseLayout>
