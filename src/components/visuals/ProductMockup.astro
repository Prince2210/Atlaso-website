---
import { Minus, Plus, Sparkles, Layers, Crosshair, Share2 } from '@lucide/astro';
import SatelliteScene from './SatelliteScene.astro';
import { product } from '../../config/site';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const layers = [
  { name: 'Optical imagery · 30 cm', swatch: 'bg-gradient-to-br from-emerald-700 to-sky-900', count: null, on: true },
  { name: 'Area of interest', swatch: 'border border-dashed border-teal-400 bg-teal-400/10', count: null, on: true },
  { name: 'Building change', swatch: 'bg-rose-400', count: '214', on: true },
  { name: 'Vessels', swatch: 'bg-amber-400', count: '6', on: true },
  { name: 'Container yards', swatch: 'bg-violet-400', count: '1', on: true },
  { name: 'Land cover', swatch: 'bg-lime-500', count: null, on: false },
];
const bars = [18, 22, 20, 28, 26, 34, 31, 42, 48, 46, 61, 74];
---

<div
  class:list={[
    'relative overflow-hidden rounded-2xl border border-border bg-card shadow-elevated ring-1 ring-black/5 dark:ring-white/5',
    className,
  ]}
>
  <!-- Window chrome -->
  <div class="flex h-11 items-center gap-3 border-b border-border bg-muted/70 px-4">
    <div class="flex gap-1.5" aria-hidden="true">
      <span class="size-2.5 rounded-full bg-foreground/15"></span>
      <span class="size-2.5 rounded-full bg-foreground/15"></span>
      <span class="size-2.5 rounded-full bg-foreground/15"></span>
    </div>
    <p class="min-w-0 flex-1 truncate font-mono text-[11px] text-muted-foreground">
      <span class="hidden sm:inline">Projects / </span><span class="text-foreground">Rotterdam port</span> · change monitoring
    </p>
    <span
      class="hidden items-center gap-1.5 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2 py-0.5 text-[10px] font-medium text-emerald-700 sm:inline-flex dark:text-emerald-300"
    >
      <span class="size-1.5 rounded-full bg-emerald-500"></span> Monitoring
    </span>
    <div class="hidden -space-x-1.5 md:flex" aria-hidden="true">
      <span class="grid size-6 place-items-center rounded-full bg-sky-500 text-[9px] font-semibold text-white ring-2 ring-card">AM</span>
      <span class="grid size-6 place-items-center rounded-full bg-violet-500 text-[9px] font-semibold text-white ring-2 ring-card">LF</span>
      <span class="grid size-6 place-items-center rounded-full bg-amber-500 text-[9px] font-semibold text-white ring-2 ring-card">DO</span>
    </div>
    <span class="hidden items-center gap-1 rounded-md border border-border bg-background px-2 py-1 text-[11px] font-medium text-foreground lg:inline-flex">
      <Share2 class="size-3" /> Share
    </span>
  </div>

  <div class="grid md:grid-cols-[13.5rem_1fr]">
    <!-- Sidebar -->
    <aside class="hidden border-r border-border p-4 md:block" aria-hidden="true">
      <p class="flex items-center gap-1.5 text-[11px] font-semibold tracking-wide text-muted-foreground uppercase">
        <Layers class="size-3.5" /> Layers
      </p>
      <ul class="mt-3 space-y-1">
        {
          layers.map((l) => (
            <li class:list={['flex items-center gap-2 rounded-md px-1.5 py-1.5 text-xs', l.on ? 'text-foreground' : 'text-muted-foreground']}>
              <span class:list={['size-3 shrink-0 rounded-[3px]', l.swatch, !l.on && 'opacity-40']} />
              <span class="truncate">{l.name}</span>
              {l.count && <span class="ml-auto font-mono text-[10px] text-muted-foreground">{l.count}</span>}
              <span
                class:list={[
                  'relative h-3.5 w-6 shrink-0 rounded-full transition-colors',
                  l.count ? '' : 'ml-auto',
                  l.on ? 'bg-primary' : 'bg-foreground/15',
                ]}
              >
                <span class:list={['absolute top-0.5 size-2.5 rounded-full bg-white shadow-sm', l.on ? 'right-0.5' : 'left-0.5']} />
              </span>
            </li>
          ))
        }
      </ul>

      <p class="mt-6 text-[11px] font-semibold tracking-wide text-muted-foreground uppercase">Models</p>
      <div class="mt-3 flex flex-wrap gap-1.5">
        {
          ['Buildings v4', 'Vessels v3', 'Change v2', 'Containers'].map((m) => (
            <span class="rounded-md border border-border bg-background px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground">{m}</span>
          ))
        }
      </div>

      <div class="mt-6 rounded-lg border border-border bg-background p-3">
        <p class="text-xs font-medium text-foreground">Weekly monitor</p>
        <p class="mt-0.5 text-[11px] text-muted-foreground">Next capture in 2 days</p>
        <div class="mt-2.5 h-1.5 overflow-hidden rounded-full bg-muted">
          <div class="h-full w-[72%] rounded-full bg-primary"></div>
        </div>
      </div>
    </aside>

    <!-- Map canvas -->
    <div class="relative aspect-[4/3] overflow-hidden bg-[#0a2233] sm:aspect-[16/10] md:aspect-auto md:h-[30rem]">
      <SatelliteScene uid="hero-map" overlays class="absolute inset-0 size-full" />

      <!-- Scan line -->
      <div class="pointer-events-none absolute inset-0 overflow-hidden motion-reduce:hidden" aria-hidden="true">
        <div class="flex h-1/3 w-full animate-scan items-center bg-gradient-to-b from-transparent via-teal-300/15 to-transparent">
          <div class="h-px w-full bg-teal-200/50"></div>
        </div>
      </div>

      <!-- Change summary -->
      <div
        class="absolute top-3 left-3 w-44 rounded-xl border border-white/10 bg-slate-950/75 p-3 text-white shadow-lg backdrop-blur-md sm:top-4 sm:left-4 sm:w-52"
        aria-hidden="true"
      >
        <p class="flex items-center gap-1.5 text-[10px] font-medium tracking-wide text-white/60 uppercase">
          <span class="size-1.5 rounded-full bg-rose-400"></span> Change detected
        </p>
        <p class="mt-1 text-2xl font-semibold tracking-tight">+214 <span class="text-xs font-normal text-white/60">structures</span></p>
        <div class="mt-2 flex h-8 items-end gap-[3px]">
          {bars.map((h, i) => <span class="flex-1 rounded-[2px] bg-rose-400" style={`height:${h}%;opacity:${0.35 + (i / bars.length) * 0.65}`} />)}
        </div>
        <p class="mt-1.5 flex justify-between font-mono text-[9px] text-white/45"><span>MAR 25</span><span>SEP 26</span></p>
      </div>

      <!-- Map controls -->
      <div class="absolute top-3 right-3 hidden flex-col overflow-hidden rounded-lg border border-white/10 bg-slate-950/70 text-white/80 backdrop-blur-md sm:flex sm:top-4 sm:right-4" aria-hidden="true">
        <span class="grid size-7 place-items-center border-b border-white/10"><Plus class="size-3.5" /></span>
        <span class="grid size-7 place-items-center border-b border-white/10"><Minus class="size-3.5" /></span>
        <span class="grid size-7 place-items-center"><Crosshair class="size-3.5" /></span>
      </div>

      <!-- Ask card -->
      <div
        class="absolute right-3 bottom-12 hidden w-72 rounded-xl border border-white/10 bg-slate-950/80 p-3.5 text-white shadow-2xl backdrop-blur-md sm:block sm:right-4 lg:w-80"
        aria-hidden="true"
      >
        <p class="flex items-center gap-1.5 text-[11px] font-medium text-teal-300">
          <Sparkles class="size-3.5" /> Ask {product.shortName}
        </p>
        <p class="mt-2 ml-auto w-fit max-w-[90%] rounded-lg rounded-br-sm bg-white/10 px-2.5 py-1.5 text-xs">
          How many new buildings appeared since March 2025?
        </p>
        <p class="mt-2.5 text-xs leading-relaxed text-white/85">
          <span class="font-semibold text-white">214 new structures</span> inside your AOI — mostly a 1.6&nbsp;ha residential
          development north of the river. Vessel traffic is up <span class="font-semibold text-white">18%</span>.
        </p>
        <div class="mt-2.5 flex flex-wrap gap-1.5">
          <span class="rounded bg-white/10 px-1.5 py-0.5 font-mono text-[9px] text-white/60">OPTICAL · 18 SEP 2026</span>
          <span class="rounded bg-white/10 px-1.5 py-0.5 font-mono text-[9px] text-white/60">CONF 0.96</span>
        </div>
      </div>

      <!-- Footer: scale, coordinates, timeline -->
      <div class="absolute inset-x-0 bottom-0 flex items-center gap-3 bg-gradient-to-t from-slate-950/80 to-transparent px-3 pt-6 pb-2.5 font-mono text-[10px] text-white/70 sm:px-4" aria-hidden="true">
        <span class="flex items-center gap-1.5">
          <span class="h-1.5 w-10 border-x border-b border-white/70"></span> 250 m
        </span>
        <span class="hidden flex-1 items-center gap-2 sm:flex">
          <span>2025</span>
          <span class="relative h-1 flex-1 rounded-full bg-white/20">
            <span class="absolute inset-y-0 left-0 w-[86%] rounded-full bg-teal-300/70"></span>
            <span class="absolute top-1/2 left-[86%] size-2.5 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-teal-200 bg-slate-950"></span>
          </span>
          <span>2026</span>
        </span>
        <span class="ml-auto sm:ml-0">51.9244° N, 4.4777° E</span>
      </div>
    </div>
  </div>
</div>
