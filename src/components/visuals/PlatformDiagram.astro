---
import {
  ArrowDown,
  ArrowRight,
  BellRing,
  Boxes,
  BrainCircuit,
  Code,
  Database,
  Diff,
  FileOutput,
  LayoutDashboard,
  Mountain,
  Plane,
  Radar,
  Satellite,
  Sparkles,
} from '@lucide/astro';
import { product } from '../../config/site';

const inputs = [
  { icon: Satellite, label: 'Optical satellite', meta: '30 cm – 10 m' },
  { icon: Radar, label: 'SAR radar', meta: 'All-weather, day & night' },
  { icon: Plane, label: 'Aerial & drone', meta: '1 – 10 cm' },
  { icon: Mountain, label: 'Elevation', meta: 'DSM / DTM / LiDAR' },
  { icon: Database, label: 'Your data', meta: 'Vectors, tables, labels' },
];

const engine = [
  { icon: BrainCircuit, label: 'Geospatial foundation model', meta: 'Pre-trained on 4B km² of imagery' },
  { icon: Boxes, label: 'Task models', meta: '40+ detectors & segmenters' },
  { icon: Diff, label: 'Change engine', meta: 'Seasonal & sensor-aware baselines' },
  { icon: Sparkles, label: 'Geo-reasoning', meta: 'Natural-language questions' },
];

const outputs = [
  { icon: LayoutDashboard, label: 'Workspace & maps', meta: 'Explore, compare, share' },
  { icon: BellRing, label: 'Alerts & webhooks', meta: 'Email, Slack, Teams, HTTP' },
  { icon: Code, label: 'API & SDKs', meta: 'REST, Python, TypeScript' },
  { icon: FileOutput, label: 'Exports & BI', meta: 'GeoParquet, COG, OGC' },
];
---

<div class="grid items-center gap-4 lg:grid-cols-[1fr_auto_1.15fr_auto_1fr] lg:gap-5">
  <!-- Inputs -->
  <div class="rounded-2xl border border-border bg-card p-4 shadow-soft">
    <p class="px-2 pt-1 pb-3 font-mono text-[11px] font-medium tracking-[0.14em] text-muted-foreground uppercase">Sources</p>
    <ul class="space-y-1">
      {
        inputs.map((i) => (
          <li class="flex items-center gap-3 rounded-lg px-2 py-2">
            <i.icon class="size-4 shrink-0 text-muted-foreground" />
            <span class="min-w-0">
              <span class="block text-sm font-medium text-foreground">{i.label}</span>
              <span class="block text-xs text-muted-foreground">{i.meta}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="flex justify-center text-muted-foreground" aria-hidden="true">
    <ArrowDown class="size-5 lg:hidden" />
    <ArrowRight class="hidden size-5 lg:block" />
  </div>

  <!-- Engine -->
  <div class="relative rounded-2xl border border-primary/40 bg-card p-4 shadow-elevated ring-4 ring-primary/10">
    <p class="flex items-center justify-between px-2 pt-1 pb-3">
      <span class="font-mono text-[11px] font-medium tracking-[0.14em] text-primary uppercase">{product.name} engine</span>
      <span class="rounded-full bg-primary-soft px-2 py-0.5 text-[10px] font-semibold text-primary-soft-foreground">AI</span>
    </p>
    <ul class="grid gap-2">
      {
        engine.map((e) => (
          <li class="flex items-center gap-3 rounded-xl border border-border bg-background px-3 py-3">
            <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-primary-soft text-primary-soft-foreground">
              <e.icon class="size-4" />
            </span>
            <span class="min-w-0">
              <span class="block text-sm font-medium text-foreground">{e.label}</span>
              <span class="block text-xs text-muted-foreground">{e.meta}</span>
            </span>
          </li>
        ))
      }
    </ul>
    <p class="mt-3 rounded-lg bg-muted px-3 py-2 text-center font-mono text-[11px] text-muted-foreground">
      Analysis-ready data cube · STAC catalog
    </p>
  </div>

  <div class="flex justify-center text-muted-foreground" aria-hidden="true">
    <ArrowDown class="size-5 lg:hidden" />
    <ArrowRight class="hidden size-5 lg:block" />
  </div>

  <!-- Outputs -->
  <div class="rounded-2xl border border-border bg-card p-4 shadow-soft">
    <p class="px-2 pt-1 pb-3 font-mono text-[11px] font-medium tracking-[0.14em] text-muted-foreground uppercase">Outcomes</p>
    <ul class="space-y-1">
      {
        outputs.map((o) => (
          <li class="flex items-center gap-3 rounded-lg px-2 py-2">
            <o.icon class="size-4 shrink-0 text-muted-foreground" />
            <span class="min-w-0">
              <span class="block text-sm font-medium text-foreground">{o.label}</span>
              <span class="block text-xs text-muted-foreground">{o.meta}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</div>
