---
import { Code } from 'astro:components';
import { Copy, Check } from '@lucide/astro';
import type { CodeSample } from '../../data/code';

interface Props {
  samples: CodeSample[];
  title?: string;
  class?: string;
}

const { samples, title, class: className } = Astro.props;
const uid = `code-${Math.random().toString(36).slice(2, 8)}`;
---

<div
  data-code-tabs
  class:list={['overflow-hidden rounded-2xl border border-border bg-card text-left shadow-elevated', className]}
>
  <div class="flex items-center gap-2 border-b border-border bg-muted/70 px-3">
    {
      samples.length > 1 ? (
        <div role="tablist" aria-label="Code language" class="flex">
          {samples.map((s, i) => (
            <button
              type="button"
              role="tab"
              id={`${uid}-tab-${i}`}
              aria-controls={`${uid}-panel-${i}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              class="relative px-3 py-3 font-mono text-xs text-muted-foreground transition-colors hover:text-foreground aria-selected:text-foreground aria-selected:after:absolute aria-selected:after:inset-x-3 aria-selected:after:-bottom-px aria-selected:after:h-0.5 aria-selected:after:rounded-full aria-selected:after:bg-primary"
            >
              {s.label}
            </button>
          ))}
        </div>
      ) : (
        <p class="px-1 py-3 font-mono text-xs text-muted-foreground">{title ?? samples[0]?.label}</p>
      )
    }
    <button
      type="button"
      data-copy
      aria-label="Copy code"
      class="group/copy ml-auto grid size-8 place-items-center rounded-md text-muted-foreground transition-colors hover:bg-background hover:text-foreground"
    >
      <Copy class="size-4 group-data-copied/copy:hidden" />
      <Check class="hidden size-4 text-primary group-data-copied/copy:block" />
    </button>
  </div>
  {
    samples.map((s, i) => (
      <div
        role={samples.length > 1 ? 'tabpanel' : undefined}
        id={`${uid}-panel-${i}`}
        aria-labelledby={samples.length > 1 ? `${uid}-tab-${i}` : undefined}
        hidden={i !== 0}
        data-panel
        class="overflow-x-auto px-5 py-4"
      >
        <Code code={s.code} lang={s.lang} themes={{ light: 'github-light', dark: 'github-dark-dimmed' }} />
      </div>
    ))
  }
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-code-tabs]')) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-panel]'));

    const select = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        tab.setAttribute('aria-selected', String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
      });
      panels.forEach((panel, i) => (panel.hidden = i !== index));
      if (focus) tabs[index]?.focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowRight') select((i + 1) % tabs.length, true);
        if (event.key === 'ArrowLeft') select((i - 1 + tabs.length) % tabs.length, true);
      });
    });

    const copy = root.querySelector<HTMLButtonElement>('[data-copy]');
    copy?.addEventListener('click', async () => {
      const panel = panels.find((p) => !p.hidden);
      const text = panel?.querySelector('pre')?.innerText ?? '';
      try {
        await navigator.clipboard.writeText(text);
        copy.toggleAttribute('data-copied', true);
        copy.setAttribute('aria-label', 'Copied');
        setTimeout(() => {
          copy.removeAttribute('data-copied');
          copy.setAttribute('aria-label', 'Copy code');
        }, 1600);
      } catch {
        /* Clipboard unavailable (e.g. insecure context) — ignore. */
      }
    });
  }
</script>
