---
import Eyebrow from './Eyebrow.astro';

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'center' | 'left';
  as?: 'h1' | 'h2';
  class?: string;
}

const { eyebrow, title, description, align = 'center', as: Heading = 'h2', class: className } = Astro.props;
---

<div class:list={['max-w-3xl', align === 'center' ? 'mx-auto text-center' : '', className]}>
  {eyebrow && <Eyebrow class="mb-4">{eyebrow}</Eyebrow>}
  <Heading
    class:list={[
      'font-semibold text-foreground',
      Heading === 'h1' ? 'text-4xl leading-[1.08] sm:text-5xl lg:text-6xl' : 'text-3xl leading-tight sm:text-4xl',
    ]}
  >
    {title}
  </Heading>
  {
    description && (
      <p class:list={['mt-5 text-muted-foreground', Heading === 'h1' ? 'text-lg sm:text-xl' : 'text-base sm:text-lg']}>
        {description}
      </p>
    )
  }
  <slot />
</div>
