---
import { site } from '../../config/site';

interface Props {
  class?: string;
  /** Hide the wordmark and render only the mark. */
  markOnly?: boolean;
}

const { class: className, markOnly = false } = Astro.props;
// Unique gradient id so several logos can coexist on one page.
const gid = `logo-g-${Math.random().toString(36).slice(2, 8)}`;
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <svg viewBox="0 0 32 32" fill="none" class="size-8 shrink-0" aria-hidden="true">
    <defs>
      <linearGradient id={gid} x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
        <stop stop-color="#14b8a6"></stop>
        <stop offset="1" stop-color="#0e7490"></stop>
      </linearGradient>
    </defs>
    <rect width="32" height="32" rx="8" fill={`url(#${gid})`}></rect>
    <circle cx="15" cy="17" r="8" stroke="#fff" stroke-width="2"></circle>
    <ellipse cx="15" cy="17" rx="3.4" ry="8" stroke="#fff" stroke-opacity=".75" stroke-width="1.5"></ellipse>
    <path d="M7 17h16" stroke="#fff" stroke-opacity=".75" stroke-width="1.5"></path>
    <circle cx="24.5" cy="7.5" r="2.5" fill="#fbbf24"></circle>
  </svg>
  {!markOnly && <span class="text-[1.15rem] font-semibold tracking-tight text-foreground">{site.name}</span>}
</span>
