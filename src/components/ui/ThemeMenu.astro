---
import { Check, Monitor, Moon, Sun } from '@lucide/astro';

const options = [
  { value: 'light', label: 'Light', icon: Sun },
  { value: 'dark', label: 'Dark', icon: Moon },
  { value: 'system', label: 'System', icon: Monitor },
];
---

<div class="group relative" data-dropdown>
  <button
    type="button"
    data-dropdown-trigger
    aria-haspopup="menu"
    aria-expanded="false"
    aria-label="Change color theme"
    class="grid size-9 place-items-center rounded-lg text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
  >
    <Sun class="size-[18px] dark:hidden" />
    <Moon class="hidden size-[18px] dark:block" />
  </button>
  <div
    data-dropdown-panel
    role="menu"
    aria-label="Color theme"
    class="invisible absolute top-full right-0 z-50 mt-2 w-40 origin-top-right translate-y-1 scale-[0.98] rounded-xl border border-border bg-card p-1 opacity-0 shadow-elevated transition duration-150 group-data-open:visible group-data-open:translate-y-0 group-data-open:scale-100 group-data-open:opacity-100"
  >
    {
      options.map(({ value, label, icon: Icon }) => (
        <button
          type="button"
          role="menuitemradio"
          aria-checked="false"
          data-theme-option={value}
          class="group/opt flex w-full items-center gap-2.5 rounded-lg px-2.5 py-2 text-sm text-muted-foreground transition-colors hover:bg-muted hover:text-foreground aria-checked:text-foreground"
        >
          <Icon class="size-4" />
          {label}
          <Check class="ml-auto size-4 text-primary opacity-0 group-aria-checked/opt:opacity-100" />
        </button>
      ))
    }
  </div>
</div>

<script>
  import '../../scripts/dropdown';
  import '../../scripts/theme-controls';
</script>
