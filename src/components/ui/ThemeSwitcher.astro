---
import { Monitor, Moon, Sun } from '@lucide/astro';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const options = [
  { value: 'light', label: 'Light theme', icon: Sun },
  { value: 'system', label: 'System theme', icon: Monitor },
  { value: 'dark', label: 'Dark theme', icon: Moon },
];
---

<div
  role="radiogroup"
  aria-label="Color theme"
  class:list={['inline-flex items-center gap-0.5 rounded-full border border-border bg-muted p-0.5', className]}
>
  {
    options.map(({ value, label, icon: Icon }) => (
      <button
        type="button"
        role="radio"
        aria-checked="false"
        aria-label={label}
        title={label}
        data-theme-option={value}
        class="grid size-7 place-items-center rounded-full text-muted-foreground transition-colors hover:text-foreground aria-checked:bg-background aria-checked:text-foreground aria-checked:shadow-sm"
      >
        <Icon class="size-3.5" />
      </button>
    ))
  }
</div>

<script>
  import '../../scripts/theme-controls';
</script>
