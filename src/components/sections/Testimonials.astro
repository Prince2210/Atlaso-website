---
import { testimonials } from '../../data/testimonials';
import SectionHeader from '../ui/SectionHeader.astro';
import { site } from '../../config/site';
---

<section class="py-20 sm:py-28">
  <div class="container-page">
    <SectionHeader
      eyebrow="Customers"
      title="Teams that act on what’s happening on the ground"
      description={`From catastrophe response to carbon verification, customers use ${site.name} to replace slow, manual review with continuous, trustworthy insight.`}
    />
    <ul class="mt-14 grid gap-6 lg:grid-cols-3">
      {
        testimonials.map((t) => (
          <li class="flex flex-col rounded-2xl border border-border bg-card p-7 shadow-soft">
            <svg viewBox="0 0 24 24" class="size-7 text-primary/50" fill="currentColor" aria-hidden="true">
              <path d="M9.6 5C6 6.6 4 9.5 4 13.4V19h6v-6H7.3c.2-2.4 1.5-4.1 3.7-5.2L9.6 5Zm10 0C16 6.6 14 9.5 14 13.4V19h6v-6h-2.7c.2-2.4 1.5-4.1 3.7-5.2L19.6 5Z" />
            </svg>
            <blockquote class="mt-5 flex-1 text-[0.975rem] leading-relaxed text-foreground">“{t.quote}”</blockquote>
            <div class="mt-7 flex items-center gap-3 border-t border-border pt-5">
              <span class:list={['grid size-10 place-items-center rounded-full text-sm font-semibold text-white', t.color]}>
                {t.initials}
              </span>
              <span>
                <span class="block text-sm font-medium text-foreground">{t.name}</span>
                <span class="block text-sm text-muted-foreground">
                  {t.role}, {t.company}
                </span>
              </span>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
