---
import Eyebrow from '../ui/Eyebrow.astro';

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'center' | 'left';
  class?: string;
}

const { eyebrow, title, description, align = 'center', class: className } = Astro.props;
const centered = align === 'center';
---

<section class:list={['relative isolate overflow-hidden border-b border-border', className]}>
  <div class="absolute inset-0 -z-10 bg-grid mask-fade-top" aria-hidden="true"></div>
  <div class="absolute -top-40 left-1/2 -z-10 h-80 w-[48rem] -translate-x-1/2 glow" aria-hidden="true"></div>
  <div class="container-page py-16 sm:py-20 lg:py-24">
    <div class:list={['max-w-3xl', centered && 'mx-auto text-center']}>
      {eyebrow && <Eyebrow class="mb-4">{eyebrow}</Eyebrow>}
      <h1 class="text-4xl leading-[1.08] font-semibold text-foreground sm:text-5xl lg:text-[3.5rem]">{title}</h1>
      {description && <p class="mt-6 text-lg text-muted-foreground sm:text-xl">{description}</p>}
      {
        Astro.slots.has('actions') && (
          <div class:list={['mt-9 flex flex-col gap-3 sm:flex-row', centered && 'sm:justify-center']}>
            <slot name="actions" />
          </div>
        )
      }
    </div>
    <slot />
  </div>
</section>
