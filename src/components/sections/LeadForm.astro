---
import { CircleCheck, LoaderCircle } from '@lucide/astro';
import { site } from '../../config/site';
import { services } from '../../data/services';

interface Props {
  /** `project` is the scoping-call form; `contact` is the general one. */
  variant?: 'contact' | 'project';
  class?: string;
}

const { variant = 'contact', class: className } = Astro.props;
const isProject = variant === 'project';
const uid = `form-${variant}`;

const topics = [
  ...services.map((s) => ({ value: s.slug, label: s.name })),
  { value: 'partnering', label: 'White-label partnering' },
  { value: 'other', label: 'Something else' },
];

const orgTypes = ['Utility or municipality', 'GIS consultancy', 'Esri partner', 'Engineering firm', 'Other'];
const platforms = ['ArcMap and Geometric Network', 'ArcGIS Pro, not yet on Utility Network', 'ArcGIS Utility Network', 'Open source (QGIS, GeoServer, PostGIS)', 'Files and CAD', 'Not sure'];

const input =
  'block w-full rounded-lg border border-input bg-background px-3.5 py-2.5 text-sm text-foreground shadow-xs transition placeholder:text-muted-foreground/70 focus:border-primary focus:ring-4 focus:ring-primary/15 focus:outline-none user-invalid:border-rose-500';
const label = 'mb-1.5 block text-sm font-medium text-foreground';
---

<div class:list={['rounded-3xl border border-border bg-card p-6 shadow-elevated sm:p-8', className]}>
  <form id={uid} data-lead-form data-endpoint={site.formEndpoint} novalidate class="space-y-5">
    <input type="hidden" name="form" value={variant} />
    <!-- Honeypot: humans never see or fill this. -->
    <div class="hidden" aria-hidden="true">
      <label>Leave this empty <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for={`${uid}-first`} class={label}>First name</label>
        <input id={`${uid}-first`} name="firstName" type="text" autocomplete="given-name" required class={input} />
      </div>
      <div>
        <label for={`${uid}-last`} class={label}>Last name</label>
        <input id={`${uid}-last`} name="lastName" type="text" autocomplete="family-name" required class={input} />
      </div>
    </div>

    <div>
      <label for={`${uid}-email`} class={label}>Work email</label>
      <input id={`${uid}-email`} name="email" type="email" autocomplete="email" required placeholder="you@company.com" class={input} />
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for={`${uid}-company`} class={label}>Company</label>
        <input id={`${uid}-company`} name="company" type="text" autocomplete="organization" required class={input} />
      </div>
      <div>
        <label for={`${uid}-topic`} class={label}>{isProject ? 'Service' : 'How can we help?'}</label>
        <select id={`${uid}-topic`} name="topic" required class={input} data-prefill="topic">
          {topics.map((t) => (
            <option value={t.value}>{t.label}</option>
          ))}
        </select>
      </div>
    </div>

    {
      isProject && (
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for={`${uid}-org`} class={label}>You are a…</label>
            <select id={`${uid}-org`} name="organisationType" required class={input} data-prefill="org">
              <option value="" disabled selected>
                Select…
              </option>
              {orgTypes.map((o) => (
                <option value={o}>{o}</option>
              ))}
            </select>
          </div>
          <div>
            <label for={`${uid}-platform`} class={label}>Current setup</label>
            <select id={`${uid}-platform`} name="currentSetup" required class={input}>
              <option value="" disabled selected>
                Select…
              </option>
              {platforms.map((p) => (
                <option value={p}>{p}</option>
              ))}
            </select>
          </div>
        </div>
      )
    }

    <div>
      <label for={`${uid}-message`} class={label}>
        {isProject ? 'Tell us about the project' : 'Message'}
        {isProject && <span class="font-normal text-muted-foreground"> (optional)</span>}
      </label>
      <textarea
        id={`${uid}-message`}
        name="message"
        rows="4"
        required={!isProject}
        placeholder={isProject ? 'e.g. Water network on a geometric network in ArcMap, two service areas, go-live next year.' : 'Tell us a little about what you need…'}
        class={`${input} resize-y`}></textarea>
    </div>

    <label class="flex items-start gap-3 text-sm text-muted-foreground">
      <input type="checkbox" name="consent" required class="mt-0.5 size-4 shrink-0 rounded border-input accent-[var(--primary)]" />
      <span>
        I agree to the <a href="/privacy" class="font-medium text-foreground underline underline-offset-2 hover:text-primary">privacy policy</a> and to
        being contacted about my enquiry.
      </span>
    </label>

    <p data-error hidden role="alert" class="rounded-lg border border-rose-500/30 bg-rose-500/10 px-3.5 py-2.5 text-sm text-rose-700 dark:text-rose-300">
      Something went wrong. Please try again, or email us at <a href={`mailto:${site.email.hello}`} class="underline">{site.email.hello}</a>.
    </p>

    <button
      type="submit"
      class="group/submit inline-flex h-12 w-full items-center justify-center gap-2 rounded-lg bg-primary px-6 font-medium text-primary-foreground shadow-sm transition-colors hover:bg-primary-hover disabled:cursor-wait disabled:opacity-70"
    >
      <LoaderCircle class="hidden size-4 animate-spin group-disabled/submit:block" />
      {isProject ? 'Request a scoping call' : 'Send message'}
    </button>
    {isProject && <p class="text-center text-xs text-muted-foreground">We usually reply within one business day.</p>}
  </form>

  <div data-success hidden tabindex="-1" class="py-10 text-center outline-none">
    <span class="mx-auto grid size-14 place-items-center rounded-full bg-primary-soft text-primary-soft-foreground">
      <CircleCheck class="size-7" />
    </span>
    <h2 class="mt-6 text-2xl font-semibold text-foreground">{isProject ? 'Your request is in' : 'Thanks — message received'}</h2>
    <p class="mx-auto mt-3 max-w-sm text-muted-foreground">
      {
        isProject
          ? 'We’ll reply within one business day with a few times for a call that suit your time zone.'
          : 'We’ll get back to you within one business day.'
      }
    </p>
  </div>
</div>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-lead-form]')) {
    const wrapper = form.parentElement!;
    const success = wrapper.querySelector<HTMLElement>('[data-success]')!;
    const error = form.querySelector<HTMLElement>('[data-error]')!;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

    // Prefill selects from the query string, e.g. /book-a-call?topic=web-gis-apps.
    const params = new URLSearchParams(window.location.search);
    for (const field of form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-prefill]')) {
      const value = params.get(field.dataset.prefill!);
      if (!value) continue;
      if (field instanceof HTMLSelectElement && ![...field.options].some((o) => o.value === value)) continue;
      field.value = value;
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      error.hidden = true;
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const data: Record<string, FormDataEntryValue> = Object.fromEntries(new FormData(form));
      if (data._gotcha) return; // Bot filled the honeypot.

      // Email-friendly metadata (understood by Formspree and similar services):
      // a readable subject line, and replies go straight to the person who wrote in.
      const who = `${data.firstName} ${data.lastName}${data.company ? `, ${data.company}` : ''}`;
      data._subject = data.form === 'project' ? `Scoping call request (${data.topic}): ${who}` : `Website message (${data.topic}): ${who}`;
      data._replyto = data.email;

      submit.disabled = true;
      try {
        const endpoint = form.dataset.endpoint;
        if (endpoint) {
          const res = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(data),
          });
          if (!res.ok) throw new Error(`Request failed: ${res.status}`);
        } else {
          // No endpoint configured yet (see `formEndpoint` in src/config/site.ts) — simulate success.
          await new Promise((resolve) => setTimeout(resolve, 700));
        }
        form.hidden = true;
        success.hidden = false;
        success.focus();
      } catch {
        error.hidden = false;
        submit.disabled = false;
      }
    });
  }
</script>
