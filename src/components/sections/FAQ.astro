---
import { Plus } from '@lucide/astro';
import SectionHeader from '../ui/SectionHeader.astro';

interface Props {
  items: { q: string; a: string }[];
  title?: string;
  description?: string;
}

const { items, title = 'Frequently asked questions', description } = Astro.props;
---

<section class="py-20 sm:py-24">
  <div class="container-page grid gap-12 lg:grid-cols-[1fr_1.6fr] lg:gap-16">
    <SectionHeader eyebrow="FAQ" title={title} description={description} align="left">
      <p class="mt-6 text-sm text-muted-foreground">
        Still have questions? <a href="/contact" class="font-medium text-primary hover:underline">Contact our team</a>.
      </p>
    </SectionHeader>
    <div class="divide-y divide-border border-y border-border">
      {
        items.map((item) => (
          <details class="group py-1" name="faq">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-4 text-left font-medium text-foreground [&::-webkit-details-marker]:hidden">
              {item.q}
              <Plus class="mt-0.5 size-5 shrink-0 text-muted-foreground transition-transform duration-200 group-open:rotate-45" />
            </summary>
            <p class="pr-10 pb-5 leading-relaxed text-muted-foreground">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
